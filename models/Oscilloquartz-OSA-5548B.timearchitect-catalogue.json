{
  "entries": [
    {
      "description": "From Oscilloquartz OSA 5548B SASE datasheet, edition 3 June 2004. Shown as an SSU with the BVA 8600 oscillator, six 2048 kbit/s inputs and one module of sixteen 2048 kbit/s outputs.",
      "id": "9fc01ad6-4cf9-4ee8-a6b8-4320d6408a02",
      "name": "Oscilloquartz OSA 5548B",
      "node": {
        "clock_type": "g812-type-i",
        "description": "",
        "equipment": [
          [
            "Vendor",
            "Oscilloquartz"
          ],
          [
            "Model",
            "OSA 5548B SASE (Stand-Alone Synchronisation Equipment), the core of the OSA 6500B PRC"
          ],
          [
            "Oscillator",
            "BVA 8600 (double oven; G.811 for at least 24 h in holdover; < 2E-11/day) or OCXO 8665 (G.812 Type I, V and VI; < 2E-10/day)"
          ],
          [
            "Inputs",
            "6 slots: 2.048 Mbit/s and 1.544 Mbit/s with SSM, 0.064, 1, 1.544, 2.048, 5 or 10 MHz; up to two GPS receivers, two slots each"
          ],
          [
            "Selection",
            "Automatic (priority), SSM, performance, majority decision and forced modes"
          ],
          [
            "Outputs",
            "8 slots of 16: 2.048 Mbit/s and 1.544 Mbit/s with SSM, 2.048 MHz, 64/8 kbit/s CC, 5 and 10 MHz; up to 112 unprotected or 64 protected; more with OSA 5530B expansion sub-racks"
          ],
          [
            "Squelch",
            "Automatic, configurable, on prolonged holdover"
          ],
          [
            "Redundancy",
            "Two input line selectors, two tracking oscillator modules, two phase stepper switches, two power supplies"
          ],
          [
            "Power",
            "Up to 2 supplies: 36-72 V DC, 92-132 V AC or 196-264 V AC"
          ],
          [
            "Size",
            "ETSI 12U, 532 x 535 x 265 mm; 19 inch 6U, 266 x 483 x 265 mm"
          ],
          [
            "Source",
            "Oscilloquartz OSA 5548B SASE datasheet, edition 3 June 2004"
          ]
        ],
        "holdover_hours": 24,
        "holdover_ql": "QL-SSU-A",
